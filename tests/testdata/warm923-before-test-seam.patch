diff --git a/rust/crates/core/src/snapshot_warm923_before_tests.rs b/rust/crates/core/src/snapshot_warm923_before_tests.rs
new file mode 100644
index 0000000..857b630
--- /dev/null
+++ b/rust/crates/core/src/snapshot_warm923_before_tests.rs
@@ -0,0 +1,101 @@
+fn warm923_validation_fixture(count: usize) -> (Scenario, Arc<NativeStore>, Value, Value) {
+    let scenario = Scenario::new(count, |index| session_line(&format!("thread-{index:04}")));
+    std::fs::write(&scenario.root.path, tool_line("root", "Bash")).unwrap();
+    let store = Arc::new(prepared_store());
+    let owner = context_for("graph-validation", false);
+    let (root, _) = acquired(&store, &scenario.root.path, &owner);
+    let graph = prepared_graph(&store, &root, &scenario.direct(), &owner);
+    (scenario, store, owner, graph)
+}
+
+#[test]
+fn cache_warm923_validation_cancellation_stops_before_the_next_member() {
+    let (_scenario, store, owner, graph) = warm923_validation_fixture(923);
+    let calls = Arc::new(AtomicUsize::new(0));
+    let observed = Arc::clone(&calls);
+    let cancellation = Cancellation::default();
+    let cancelled = cancellation.clone();
+    *store.graph_validation_hook.lock().unwrap() = Some(Arc::new(move |_| {
+        if observed.fetch_add(1, Ordering::Relaxed) == 0 { cancelled.cancel(); }
+    }));
+    let response = store.request(&graph_query(&graph, marker_tool(), json!([])), &owner, &cancellation);
+    assert_eq!(response["status"].as_str(), Some("cancelled"), "{response:?}");
+    assert_eq!(calls.load(Ordering::Relaxed), 1, "WARM923_VALIDATION_KEPT_SCANNING_AFTER_CANCEL");
+    let state = store.lock_state();
+    let graph = state.prepared_graphs[graph["graph_id"].as_str().unwrap()].lock().unwrap();
+    assert!(!graph.validated, "WARM923_CANCELLED_VALIDATION_WAS_PUBLISHED");
+    assert!(state.retained_source_owners.is_empty());
+    drop(graph);
+    drop(state);
+    assert_eq!(ledger(&store), audited(&store));
+}
+
+#[test]
+fn cache_warm923_member_metadata_does_not_hold_foreground_store_admission() {
+    let (scenario, store, owner, graph) = warm923_validation_fixture(3);
+    let (entered_tx, entered_rx) = mpsc::channel();
+    let (released_tx, released_rx) = mpsc::channel::<()>();
+    let released_rx = Mutex::new(released_rx);
+    let calls = Arc::new(AtomicUsize::new(0));
+    let observed = Arc::clone(&calls);
+    *store.graph_validation_hook.lock().unwrap() = Some(Arc::new(move |_| {
+        if observed.fetch_add(1, Ordering::Relaxed) == 0 {
+            entered_tx.send(()).unwrap();
+            let released = released_rx.lock().unwrap().recv_timeout(Duration::from_secs(10));
+            assert!(matches!(released, Ok(()) | Err(mpsc::RecvTimeoutError::Disconnected)), "metadata gate was not released");
+        }
+    }));
+    let registered_graph = Arc::downgrade(&store.lock_state().prepared_graphs[graph["graph_id"].as_str().unwrap()]);
+    let query_store = Arc::clone(&store);
+    let query_owner = owner.clone();
+    let query = graph_query(&graph, marker_tool(), json!([]));
+    let query_thread = std::thread::spawn(move || query_store.request(&query, &query_owner, &Cancellation::default()));
+    let entered = entered_rx.recv_timeout(Duration::from_secs(5));
+    let graph_lock_available = if entered.is_ok() {
+        let graph = registered_graph.upgrade().unwrap();
+        let available = graph.try_lock().is_ok();
+        Some(available)
+    } else { None };
+    let (warm_thread, foreground_thread, progress_receiver, foreground_receiver) = if entered.is_ok() {
+        let warm_store = Arc::clone(&store);
+        let mut warm_owner = owner.clone();
+        warm_owner.insert("work_class", json!("background"));
+        let request = warm_request(&scenario);
+        let (progress_tx, progress_rx) = mpsc::channel();
+        let warm_thread = std::thread::spawn(move || {
+            let response = warm_store.request(&request, &warm_owner, &Cancellation::default());
+            progress_tx.send(response.clone()).unwrap();
+            response
+        });
+        let foreground_store = Arc::clone(&store);
+        let foreground_owner = owner.clone();
+        let (foreground_tx, foreground_rx) = mpsc::channel();
+        let foreground_thread = std::thread::spawn(move || {
+            let response = foreground_store.request(&json!({"schema":SCHEMA,"id":"foreground-stats","operation":"stats"}), &foreground_owner, &Cancellation::default());
+            foreground_tx.send(response.clone()).unwrap();
+            response
+        });
+        (Some(warm_thread), Some(foreground_thread), Some(progress_rx), Some(foreground_rx))
+    } else { (None, None, None, None) };
+    let until = Instant::now() + Duration::from_secs(5);
+    let progress = progress_receiver.as_ref().map(|receiver| receiver.recv_timeout(until.saturating_duration_since(Instant::now())));
+    let foreground_progress = foreground_receiver.as_ref().map(|receiver| receiver.recv_timeout(until.saturating_duration_since(Instant::now())));
+    drop(released_tx);
+    let query_result = query_thread.join();
+    let warm_result = warm_thread.map(|thread| thread.join());
+    let foreground_result = foreground_thread.map(|thread| thread.join());
+    assert!(entered.is_ok(), "metadata gate was not reached");
+    let query_result = query_result.unwrap();
+    let warm_result = warm_result.unwrap().unwrap();
+    let foreground_result = foreground_result.unwrap().unwrap();
+    assert_eq!(query_result["status"].as_str(), Some("ok"), "{query_result:?}");
+    assert_eq!(query_result["data"]["value"].as_bool(), Some(true));
+    assert_eq!(warm_result["status"].as_str(), Some("ok"), "{warm_result:?}");
+    assert!(warm_result["usage"]["source_bytes_read"].as_u64().unwrap() > 0);
+    assert_eq!(foreground_result["status"].as_str(), Some("ok"), "{foreground_result:?}");
+    assert_eq!(graph_lock_available, Some(true), "WARM923_MEMBER_METADATA_HELD_GRAPH_LOCK");
+    assert!(foreground_progress.unwrap().is_ok(), "WARM923_FOREGROUND_BLOCKED_BY_MEMBER_METADATA");
+    assert!(progress.unwrap().is_ok(), "WARM923_BACKGROUND_BLOCKED_BY_MEMBER_METADATA");
+    assert_eq!(ledger(&store), audited(&store));
+}
